# ---- Server ----
PORT=4000
# Comma-separated list of sites allowed to call the API (CORS)
FRONTEND_URL=http://localhost:3000

# ---- Database ----
# Docker (docker-compose.yml):
DATABASE_URL=postgres://mandi:mandi_local_pw@localhost:5432/mandi_bhav
# Local Windows PostgreSQL instead? Use your own user/password, e.g.:
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/mandi_bhav
# true = create/update tables automatically (local dev only)
DB_SYNCHRONIZE=true

# ---- data.gov.in (Govt. free API) ----
# Get your key: data.gov.in -> Login -> My Account -> API key
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_PAGE_SIZE=1000

# ---- Sync ----
SYNC_ON_STARTUP=true
# Every 3 hours (India time)
SYNC_CRON=0 */3 * * *
KEEP_HISTORY_DAYS=180
# Secret for POST /api/sync/run (header: x-admin-token). Empty = disabled.
ADMIN_TOKEN=
