# ---- Server ----
PORT=4000
# Comma-separated list of sites allowed to call the API (CORS)
FRONTEND_URL=http://localhost:3000

# ---- Database ----
# Supabase (recommended): Project -> Connect -> "Session pooler" -> URI.
# Replace [YOUR-PASSWORD]; if the password has @ : / # ? characters, URL-encode them.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
# Local PostgreSQL instead:
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/mandi_bhav
# Tables go in this schema (not Supabase's public schema, which is exposed by its REST API)
DB_SCHEMA=mandi
# auto = SSL on for Supabase/remote hosts, off for localhost
DB_SSL=auto
# Optional: path to Supabase's SSL certificate (Database settings -> SSL) to also verify the server
DB_SSL_CA=
# true = create/update tables automatically (dev only; use migrations in production)
DB_SYNCHRONIZE=true

# ---- data.gov.in (Govt. free API) ----
# Get your key: data.gov.in -> Login -> My Account -> API key
DATA_GOV_API_KEY=
DATA_GOV_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_PAGE_SIZE=1000

# ---- Sync ----
SYNC_ON_STARTUP=true
# Every 3 hours (India time)
SYNC_CRON=0 */3 * * *
KEEP_HISTORY_DAYS=180
# Secret for POST /api/sync/run (header: x-admin-token). Empty = disabled.
ADMIN_TOKEN=

# ---- Rate limit ----
# Max requests per minute per IP, per endpoint. Raise if many users share one IP.
THROTTLE_LIMIT=120
