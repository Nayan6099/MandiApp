{
  "name": "mandi-bhav-api",
  "version": "0.0.1",
  "description": "Mandi Bhav API - NestJS + PostgreSQL",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
